
<div class="w-full h-16">
  <% if notice.present? %>
    <p class="py-2 px-3 mb-5 text-green-500 font-medium rounded-md inline-block" id="notice"><%= notice %></p>
  <% end %>


<%= turbo_frame_tag :messages do %> 


  <div id="chat-message" class="overflow-y-auto h-50 bg-blue-300">
    <% if @messages.any? %>
      <% @messages.order(created_at: :desc).each do |message| %>

        <div id="messages" data-controller="scroll" class="">
          <%= render message %>
         
        </div>
      <% end %>
    <% else %>
      <p class="text-center my-10">No messages found.</p>
    <% end %>



 <% end %>


</div>

<%= turbo_stream_from @chat, :messages  %>
<%= turbo_frame_tag :new_message do  %> 
 <div class="flex justify-between items-center">
   <h1 class="font-bold text-4xl">Messages</h1>
   <%= link_to "New message", new_chat_message_path(@chat), class: "rounded-md px-3.5 py-2.5 bg-blue-600 hover:bg-blue-500 text-white block font-medium" %>
 </div>
<% end %>
