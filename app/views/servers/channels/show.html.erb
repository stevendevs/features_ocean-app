
<% content_for :title, "Showing channel" %>

<%= turbo_frame_tag :dashboard do %>


  <div class="flex">
  <%= render "servers/sidebar" %>
  <div class="md:w-2/3 min-w-full bg-white flex flex-col ">
    <% if notice.present? %>
      <p class="py-2 px-3 bg-green-50 mb-5 text-green-500 font-medium rounded-md inline-block" id="notice"><%= notice %></p>
    <% end %>
  
    <h1 class="font-black text-sky-400 p-4 text-2xl"> 
    <%= @server_channel.name %>
     </h1>
  
  
  </div>
  
  </div>
 <% end %>