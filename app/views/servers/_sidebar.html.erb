<div class="w-80 min-h-screen bg-slate-800 border-r border-slate-700 shadow-sm">

  <div class="flex justify-end w-full p-4">
    <%= link_to "Create channel", new_server_channel_path(@server),
        data: { turbo_frame: :dashboard },
        class: "text-sm font-medium text-white bg-black hover:bg-gray-900 px-4 py-2 rounded-lg transition duration-200" %>
  </div>

  <div class="flex flex-col gap-2 px-4 pb-4">
    <% @server.channels.each do |channel| %>
      <%= link_to server_channel_path(@server, channel), data: { turbo_frame: :dashboard } do %>
        <div class="w-full px-4 py-3 bg-slate-700 hover:bg-slate-600 rounded-xl transition-colors duration-150">
          <span class="text-base text-gray-100 font-semibold"><%= channel.name %></span>
        </div>
      <% end %>
    <% end %>
  </div>

</div>
