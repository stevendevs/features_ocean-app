

<div class="w-80 min-h-screen bg-sky-500">
  <div class="flex justify-end w-full">
    <%= link_to "Create channel", new_server_channel_path(@server), data: { turbo_frame: :dashboard }, class: "text-white bg-red-700 hover:bg-green-800 focus:outline-none focus:ring-4 focus:ring-green-300 font-medium rounded-full text-sm px-5 py-2.5 text-center me-2 mb-2 dark:bg-green-600 dark:hover:bg-green-700 dark:focus:ring-green-800 my-6" %>
  </div>

  <div class="flex flex-col gap-2">
    <% @server.channels.each do |channel| %>
      <%= link_to server_channel_path(@server, channel), data: { turbo_frame: :dashboard } do %>
        <div class="p-2 w-full bg-gray-600">
          <span class="text-xl text-gray-100 my-8"><%= channel.name %></span>
        </div>
      <% end %>
    <% end %>
  </div>
</div>