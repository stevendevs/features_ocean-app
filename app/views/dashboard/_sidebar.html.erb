<div class="w-80 min-h-screen bg-white border-r border-gray-200 shadow-sm">

  <div class="flex justify-end w-full p-4">
    <%= link_to "Create Server", new_server_path, 
        class: "text-sm font-medium text-white bg-black hover:bg-gray-900 px-4 py-2 rounded-lg transition-colors duration-200",
        data: { turbo_frame: :dashboard } %>
  </div>

  <div class="flex flex-col h-90 gap-2 px-4 pb-4 overflow-y-auto">
    <% current_user.owned_servers.order(created_at: :desc).each do |server| %>
      <%= link_to server, data: { turbo_frame: :dashboard } do %>
        <div class="w-full px-4 py-3 bg-gray-100 hover:bg-gray-200 rounded-xl transition-colors duration-150">
          <span class="text-base text-gray-800 font-semibold"><%= server.name %></span>
        </div>
      <% end %>
    <% end %>
  </div>

</div>
