<div class="w-80 min-h-screen bg-indigo-700 ">
  <div class="flex justify-end w-full ">
    <%= link_to "Create server", new_server_path, class: "text-white bg-green-700 hover:bg-green-800 focus:outline-none focus:ring-4 focus:ring-green-300 font-medium rounded-full text-sm px-5 py-2.5 text-center me-2 mb-2 dark:bg-green-600 dark:hover:bg-green-700 dark:focus:ring-green-800 my-6" %>
  </div>

  <div class="flex flex-col gap-2">

    <% current_user.owned_servers.order(created_at: :desc).each do |server| %>

      <div class="p-2 w-full bg-gray-600">
        <span class="text-xl text-gray-100 my-8"><%= server.name %></span> 
      </div>
    <% end %>
  </div>
</div>
